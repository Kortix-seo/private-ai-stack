# Copy to .env and edit. Nothing here is a Kortix secret: Kortix keeps its own
# values in the instance .env that `kortix self-host init` writes (mode 0600).

# The model the runner pulls on first start.
MODEL_NAME=llama3.1:8b

# How long the runner keeps a model in memory between calls.
MODEL_KEEP_ALIVE=30m

# Point a Kortix project at the runner from inside the instance:
#   Customize -> Models -> Providers, base URL http://<host-ip>:11434/v1
# A container on the default bridge cannot reach 127.0.0.1 of the host, so when
# the Kortix stack runs on the same machine, publish the port on the docker
# bridge address instead of loopback, or put both compose projects on one
# network. See docs/01-setup.md, "Wiring the model endpoint".
